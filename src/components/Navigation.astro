---
import DrawnEdges from './DrawnEdges.astro';
import PenLoop from './PenLoop.astro';

// The current page is circled in pen and gets aria-current; hovering or focusing
// another tab draws the same circle in.
const path = Astro.url.pathname;
const links = [
    { href: '/', label: 'Home', current: path === '/' },
    { href: '/about/', label: 'About', current: path.startsWith('/about') },
];
---

<div class="drawn nav-links" id="primary-navigation">
    <DrawnEdges name="menu" />
    {links.map((link) => (
        <a class="tab navlink" href={link.href} aria-current={link.current ? 'page' : undefined}>
            <span>{link.label}<PenLoop name={`tab:${link.label}`} /></span>
        </a>
    ))}
</div>
