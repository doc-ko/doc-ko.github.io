---
import { drawnEdgesHtml } from '../lib/penHtml.js';

// The pen-drawn sides of a box. Put this inside an element with class "drawn"
// (position: relative; see devices.css); each side is a strip laid on a dot row
// or column and stretched to the box, so the box can be any size.
//
//   name  seed: the same name always draws the same wobble
//   keys  which sides: t r b l, or u and d for the hooks of a code bracket
//   tone  pen (notes), pencil (structure) or focus (focus rings)
//   ink   a heavier start to each side, where the pen lands; on for pen, off
//         for pencil and focus unless you ask for it (the code bracket does)
const { name, keys = 'trbl', tone = 'pen', ink = tone === 'pen' } = Astro.props;
---

<Fragment set:html={drawnEdgesHtml(name, keys, tone, ink)} />
