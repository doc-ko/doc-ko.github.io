---
import EmailLink from './EmailLink.astro';
import FieldEmblem from './FieldEmblem.astro';
import MarkdownCopy from './MarkdownCopy.astro';
import MarkdownInline from './MarkdownInline.astro';
import Note from './Note.astro';

const { hero, fields = [] } = Astro.props;
---

<section class="notebook-hero" aria-labelledby="home-title">
    <div class="notebook-grid notebook-grid--hero">
        <div class="hero-manuscript">
            <p class="eyebrow"><MarkdownInline content={hero.kicker} /></p>
            <h1 id="home-title"><MarkdownInline content={hero.headline} /></h1>
            <MarkdownCopy class="hero-lede" content={hero.lede} />

            <Note label={hero.lemma.label} notation={hero.lemma.notation} body={hero.lemma.body} dot="ink" seed="hero" />

            <nav class="quiet-links" aria-label="Homepage links">
                {hero.links.map((link) => (
                    link.email ? <EmailLink>{link.label}</EmailLink> : <a href={link.href}>{link.label}</a>
                ))}
            </nav>
        </div>

        <div class="hero-diagram-stack">
            <FieldEmblem fields={fields} />
            <Note variant="margin" label={hero.margin.label} body={hero.margin.body} seed="areas" />
        </div>
    </div>
</section>
