---
import MarkdownInline from './MarkdownInline.astro';

const { fields = [] } = Astro.props;
---

<ul class="field-emblem" aria-label="Areas of work">
    {fields.map((field) => (
        <li class={`field-emblem__tile field-emblem__tile--${field.accent}`}>
            <span class="field-emblem__symbol" aria-hidden="true">
                {field.symbol}
                {/* Hover animation for the violet tile: the sigma becomes the
                    sum of k = 0 to infinity of heart^k. */}
                {field.accent === 'violet' && (
                    <>
                        <svg class="sum-limit sum-limit--upper sum-inf" viewBox="0 0 20 10" aria-hidden="true">
                            <path class="sum-inf__path" pathLength="1" d="M10 5 C7.5 0.5 1 0.5 1 5 C1 9.5 7.5 9.5 10 5 C12.5 0.5 19 0.5 19 5 C19 9.5 12.5 9.5 10 5" />
                        </svg>
                        <span class="sum-limit sum-limit--lower"><i>k</i><span class="sum-limit__rel">=</span>0</span>
                        <span class="sum-term">
                            <svg class="sum-heart" viewBox="0 0 32 29" aria-hidden="true">
                                <defs>
                                    <linearGradient id="sum-heart-fill" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0" stop-color="#e45a50" />
                                        <stop offset="1" stop-color="#a9292b" />
                                    </linearGradient>
                                </defs>
                                <path d="M16 27.5 C3 17.5 -1 9.5 4.5 4.5 C9.5 0.5 14.5 2.5 16 7 C17.5 2.5 22.5 0.5 27.5 4.5 C33 9.5 29 17.5 16 27.5 Z" fill="url(#sum-heart-fill)" stroke="#7d1d20" stroke-width="1.4" stroke-linejoin="round" />
                            </svg>
                            <i class="sum-term__exp">k</i>
                        </span>
                    </>
                )}
            </span>
            {/* Hover animation for the amber tile: the symbol shrinks into the
                nucleus of a /jəp/ syllable tree drawn around it. The symbol is
                the schwa leaf; the svg covers the tile in percent units. */}
            {field.accent === 'amber' && (
                <svg class="syllable-tree" viewBox="0 0 100 100" aria-hidden="true">
                    <path class="syllable-tree__edge syllable-tree__edge--rime" pathLength="1" d="M50 64 L65 44 L80 64" />
                    <path class="syllable-tree__edge syllable-tree__edge--syllable" pathLength="1" d="M20 44 L42.5 24 L62.76 42" />

                    <text class="syllable-tree__leaf syllable-tree__leaf--coda" x="80" y="74.4">p</text>
                    <text class="syllable-tree__leaf syllable-tree__leaf--onset" x="20" y="57">j</text>
                </svg>
            )}
            {/* Hover animation for the cyan tile: a thought bubble is drawn to the
                upper right of the symbol, which moves to the lower left. Like the syllable tree, the svg covers the tile in
                percent units. */}
            {field.accent === 'cyan' && (
                <svg class="thought-bubble" viewBox="0 0 100 100" aria-hidden="true">
                    <circle class="thought-bubble__trail thought-bubble__trail--1" cx="41.5" cy="52.5" r="1.6" />
                    <circle class="thought-bubble__trail thought-bubble__trail--2" cx="46" cy="45" r="2.6" />
                    <path class="thought-bubble__cloud" pathLength="1" d="M44 35 A8 8 0 0 1 42 21 A9 9 0 0 1 56 16 A9 9 0 0 1 71 17 A8 8 0 0 1 80 27 A8 8 0 0 1 75 36 A8 8 0 0 1 61 37 A8 8 0 0 1 44 35" />
                    <circle class="thought-bubble__dot thought-bubble__dot--1" cx="53" cy="26.5" r="1.5" />
                    <circle class="thought-bubble__dot thought-bubble__dot--2" cx="61" cy="26.5" r="1.5" />
                    <circle class="thought-bubble__dot thought-bubble__dot--3" cx="69" cy="26.5" r="1.5" />
                </svg>
            )}
            <span class="field-emblem__label"><MarkdownInline content={field.title} /></span>
        </li>
    ))}
</ul>
