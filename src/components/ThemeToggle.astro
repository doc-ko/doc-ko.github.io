---
import IconHatch from './IconHatch.astro';
---

<button class="drawn tab iconbtn theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme">
    <IconHatch name="theme" />
    <svg class="theme-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
        <g class="theme-toggle__sun" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" fill="currentColor" />
            <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4" />
        </g>
        <path
            class="theme-toggle__moon"
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
        />
    </svg>
</button>
