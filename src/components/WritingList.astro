---
import MarkdownCopy from './MarkdownCopy.astro';
import MarkdownInline from './MarkdownInline.astro';

const { items = [] } = Astro.props;
---

<div class="writing-list">
    {items.map((item) => (
        <article class={`writing-item writing-item--${item.accent}`}>
            <div>
                <p class="writing-item__kind"><MarkdownInline content={item.kind} /></p>
                <h3><a href={item.href}><MarkdownInline content={item.title} /></a></h3>
                <MarkdownCopy class="writing-item__description" content={item.description} />
            </div>
            <code>{item.notation}</code>
        </article>
    ))}
</div>
