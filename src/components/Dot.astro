---
// A coloured grid dot: it marks where you are (the current page) or which
// field something belongs to. Always sits on a dot of the grid, so place it in
// an element with class "drawn" at the dot's corner. The ring of paper round it
// hides the grey dot underneath.
//
//   color  ink (current page, status notes), amber, cyan or violet (fields)
const { color = 'ink' } = Astro.props;
---

<i class={`dot dot--${color}`} aria-hidden="true"></i>
