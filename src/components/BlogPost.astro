---
import Note from './Note.astro';
import { postUrl, postDate } from '../lib/posts.js';

// One post in a list: a margin note whose label is the date, then the title as
// a link and the description. Each note hangs from the one above, so a list
// reads as a timeline. A post marked AI gets the AI strip and text marking.
//
//   post  the post entry from the posts collection; the link, title, date,
//         description and origin all come from it, so every list looks the same
const { post } = Astro.props;
const { title, description, origin } = post.data;
const url = postUrl(post);
---

<li>
    <Note variant="margin" label={postDate(post)} origin={origin} seed={url}>
        <p><a class="text-link" href={url}>{title}</a></p>
        {description && <p>{description}</p>}
    </Note>
</li>
