---
const { link, text, variant = 'secondary' } = Astro.props;
const isExternal = link.startsWith('http');
---

<a
    class={variant === 'primary' ? 'button-link' : 'button-link button-link--secondary'}
    href={link}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noreferrer' : undefined}
>{text}</a>
