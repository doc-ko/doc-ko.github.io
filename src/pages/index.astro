---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Note from '../components/Note.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { homepage } from '../data/homepage.js';

const { meta, hero, sections, fields, notes } = homepage;
---

<BaseLayout
	pageTitle={meta.title}
	description={meta.description}
	hideTitle={true}
>
	<div class="notebook-home">
		<HomeHero hero={hero} fields={fields} />

		<section class="notebook-section" aria-labelledby="method-title">
			<div class="notebook-grid">
				<div>
					<SectionHeading
						number={sections.method.number}
						title={sections.method.title}
						note={sections.method.note}
					/>
					<div class="note-grid">
						{notes.map((item) => (
							<Note
								label={item.kind}
								title={item.title}
								notation={item.notation}
								body={item.body}
								dot="ink"
								seed={item.title}
							/>
						))}
					</div>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
