---
import BlogPost from '../../components/BlogPost.astro'
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, postUrl } from '../../lib/posts.js';

export async function getStaticPaths() {
    const allPosts = await getPosts();

    return getTags(allPosts).map((tag) => ({
        params: { tag },
        props: { posts: allPosts.filter((post) => post.data.tags.includes(tag)) },
    }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag}>
    <p>Posts tagged with {tag}:</p>
    <ul class="content-list">
        {posts.map((post) => <BlogPost url={postUrl(post)} title={post.data.title} />)}
    </ul>
</BaseLayout>
