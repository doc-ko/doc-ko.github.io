---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkButton from '../../components/LinkButton.astro';

const pageTitle = 'Work';
const withTrailingSlash = (url) => url.endsWith('/') ? url : `${url}/`;
const caseStudies = (await Astro.glob('./*.md'))
    .filter((page) => !page.frontmatter.draft)
    .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());
---

<BaseLayout
    pageTitle={pageTitle}
    description="Selected technical writing samples by Karl Oberio."
>
    <section class="intro-block">
        <p class="lede">
            These samples focus on developer documentation: API context, OpenAPI workflows, and procedural writing. Coding case studies will stay unpublished until they have enough context to be genuinely useful.
        </p>
    </section>

    <section class="work-list" aria-label="Writing case studies">
        {caseStudies.map((page) => (
            <article class="work-card work-card--wide">
                <div>
                    <p class="card-kicker">{page.frontmatter.role ?? 'Writing sample'}</p>
                    <h2><a href={withTrailingSlash(page.url)}>{page.frontmatter.title}</a></h2>
                    <p>{page.frontmatter.description}</p>
                </div>
                <dl class="compact-details">
                    {page.frontmatter.audience && (
                        <div>
                            <dt>Audience</dt>
                            <dd>{page.frontmatter.audience}</dd>
                        </div>
                    )}
                    {page.frontmatter.tools && (
                        <div>
                            <dt>Tools</dt>
                            <dd>{Array.isArray(page.frontmatter.tools) ? page.frontmatter.tools.join(', ') : page.frontmatter.tools}</dd>
                        </div>
                    )}
                </dl>
            </article>
        ))}
    </section>

    <section class="contact-callout">
        <div>
            <h2>Want the thinking behind a sample?</h2>
            <p>I can walk through the writing choices, source assumptions, and how I would adapt the piece for a real product team.</p>
        </div>
        <LinkButton link="mailto:yarn@docko.dev" text="Contact Karl" variant="primary" />
    </section>
</BaseLayout>
