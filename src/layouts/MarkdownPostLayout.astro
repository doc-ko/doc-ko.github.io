---
import BaseLayout from './BaseLayout.astro';
import PencilRule from '../components/PencilRule.astro';
import Tag from '../components/Tag.astro';
import 'katex/dist/katex.min.css';
const { frontmatter, slug, description } = Astro.props;
const tags = frontmatter.tags ?? [];
const origin = frontmatter.origin === 'ai' ? 'ai' : undefined;
const date = frontmatter.pubDate
    ? new Date(frontmatter.pubDate).toLocaleDateString('en-NZ', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    })
    : '';
const machineDate = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString().slice(0, 10) : '';
const detailItems = [
    frontmatter.role && ['Role', frontmatter.role, origin],
    frontmatter.tools && ['Tools', Array.isArray(frontmatter.tools) ? frontmatter.tools.join(', ') : frontmatter.tools],
    frontmatter.audience && ['Audience', frontmatter.audience, origin],
    frontmatter.outcome && ['Outcome', frontmatter.outcome, origin],
].filter(Boolean);
---

<BaseLayout
    pageTitle={frontmatter.title}
    description={description ?? frontmatter.description}
    type="article"
    image={`/og/posts/${slug}.png`}
    publishedTime={machineDate || undefined}
>
    <article class="markdown-entry">
        <header class="entry-header">
            {frontmatter.description && <p class="entry-description" data-origin={origin}>{frontmatter.description}</p>}
            <p class="entry-byline">
                {date && <time datetime={machineDate}>{date}</time>}
                {frontmatter.author && <span>Written by {frontmatter.author}</span>}
            </p>
            {frontmatter.image && <img class="entry-image" src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} /> }
        </header>

        <PencilRule name="post-header" />

        {(detailItems.length > 0 || tags.length > 0) && (
            <aside aria-label="Page details">
                <dl class:list={['entry-details', detailItems.length === 0 && 'entry-details--captioned']}>
                    {detailItems.map(([label, value, valueOrigin]) => (
                        <div>
                            <dt>{label}</dt>
                            <dd data-origin={valueOrigin}>{value}</dd>
                        </div>
                    ))}

                    {tags.length > 0 && (
                        <div>
                            <dt>Tags</dt>
                            <dd class="tags">
                                {tags.map((tag) => <Tag tag={tag} />)}
                            </dd>
                        </div>
                    )}
                </dl>
            </aside>
        )}

        <div class="entry-content" data-origin={origin}>
            <slot />
        </div>
    </article>
</BaseLayout>

<style is:global>
    /* katex.min.css is not in a cascade layer, so it beats the layered grid rule
       that gives display maths a whole unit of margin (grid.css). */
    .entry-content .katex-display {
        margin: 0 0 var(--u);
    }

    /* An inline block is skipped by the AI text decoration (devices.css), which
       keeps display maths unmarked inside marked text. */
    .entry-content[data-origin="ai"] .katex-display {
        display: inline-block;
        width: 100%;
        vertical-align: top;
    }
</style>
