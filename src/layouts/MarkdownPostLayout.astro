---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const tags = frontmatter.tags ?? [];
const date = frontmatter.pubDate
    ? new Date(frontmatter.pubDate).toLocaleDateString('en-NZ', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    })
    : '';
const machineDate = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString().slice(0, 10) : '';
const detailItems = [
    frontmatter.role && ['Role', frontmatter.role],
    frontmatter.tools && ['Tools', Array.isArray(frontmatter.tools) ? frontmatter.tools.join(', ') : frontmatter.tools],
    frontmatter.audience && ['Audience', frontmatter.audience],
    frontmatter.outcome && ['Outcome', frontmatter.outcome],
].filter(Boolean);
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
    <article class="markdown-entry">
        <header class="entry-header">
            {frontmatter.description && <p class="entry-description">{frontmatter.description}</p>}
            <p class="entry-byline">
                {date && <time datetime={machineDate}>{date}</time>}
                {frontmatter.author && <span>Written by {frontmatter.author}</span>}
            </p>
            {frontmatter.image && <img class="entry-image" src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} /> }
        </header>

        {(detailItems.length > 0 || tags.length > 0) && (
            <aside aria-label="Page details">
                <dl class="entry-details">
                    {detailItems.map(([label, value]) => (
                        <div>
                            <dt>{label}</dt>
                            <dd>{value}</dd>
                        </div>
                    ))}

                    {tags.length > 0 && (
                        <div>
                            <dt>Tags</dt>
                            <dd class="tags">
                                {tags.map((tag) => (
                                    <a class="tag" href={`/tags/${tag}/`}>{tag}</a>
                                ))}
                            </dd>
                        </div>
                    )}
                </dl>
            </aside>
        )}

        <div class="entry-content">
            <slot />
        </div>
    </article>
</BaseLayout>
