---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/grid.css';
import '../styles/devices.css';
import '../styles/pages.css';
import { siteName } from '../lib/site.js';
import { homepage } from '../data/homepage.js';
const {
    pageTitle,
    description = homepage.meta.description,
    hideTitle = false,
    // Path of the link-preview card, and what kind of page it previews.
    image = '/og/default.png',
    type = 'website',
    publishedTime,
} = Astro.props;
// The tab and search title names the site; the preview card already shows it.
const fullTitle = pageTitle === siteName ? siteName : `${pageTitle} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<html lang="en-gb">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonical} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${pageTitle}, on ${siteName}`} />
        <meta property="og:locale" content="en_GB" />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="preload" href="/fonts/literata-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/literata-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
        <title>{fullTitle}</title>
        <script is:inline>
            // Set the theme before first paint. No stored choice means follow the system.
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
            } catch {}
        </script>
    </head>
    
    <body>
        <div class="page">
            <a class="skip-link" href="#main-content">Skip to content</a>
            <Header />

            <main id="main-content" class={hideTitle ? 'site-main site-main--no-title' : 'site-main'}>
                {!hideTitle && <h1>{pageTitle}</h1>}
                <slot />
            </main>

            <Footer />
        </div>

        <script>
            import "../scripts/grid.js";
            import "../scripts/menu.js";
            import "../scripts/ai-note.js";
            import "../scripts/theme.js";
            import "../scripts/email.js";
        </script>
    </body>
</html>
