---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/grid.css';
import '../styles/devices.css';
import '../styles/pages.css';
const {
    pageTitle,
    description = "Karl Oberio is a technical writer with engineering depth.",
    hideTitle = false,
} = Astro.props;
---

<html lang="en-gb">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="preload" href="/fonts/literata-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/literata-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
        <title>{pageTitle}</title>
        <script is:inline>
            // Set the theme before first paint. No stored choice means follow the system.
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
            } catch {}
        </script>
    </head>
    
    <body>
        <div class="page">
            <a class="skip-link" href="#main-content">Skip to content</a>
            <Header />

            <main id="main-content" class={hideTitle ? 'site-main site-main--no-title' : 'site-main'}>
                {!hideTitle && <h1>{pageTitle}</h1>}
                <slot />
            </main>

            <Footer />
        </div>

        <script>
            import "../scripts/grid.js";
            import "../scripts/menu.js";
            import "../scripts/ai-note.js";
            import "../scripts/theme.js";
            import "../scripts/email.js";
        </script>
    </body>
</html>
